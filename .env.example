# ── 사이트 ───────────────────────────────────────────────
# 배포 도메인 (OG 이미지·공유 링크의 절대 URL). 끝에 / 없이.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kakao Developers > 내 애플리케이션 > 앱 키 > JavaScript 키
# 플랫폼 > Web 에 위 도메인을 등록해야 공유가 동작해요.
NEXT_PUBLIC_KAKAO_JS_KEY=

# ── 콘텐츠 API (docs/api.md) ─────────────────────────────
# 테스트 데이터를 주는 서버 주소. 끝에 / 없이. 예: https://api.wibble.guru/v1
WIBBLE_API_URL=
# (선택) 서버가 인증을 요구하면 Bearer 토큰
WIBBLE_API_TOKEN=
# (선택) 요청 타임아웃 ms. 기본 8000
WIBBLE_API_TIMEOUT_MS=
# (선택) 썸네일 이미지가 API와 다른 도메인에 있으면 쉼표로 나열. 예: cdn.wibble.guru,images.example.com
WIBBLE_IMAGE_HOSTS=

# ── 캐시 무효화 웹훅 (POST /api/revalidate) ──────────────
# 백엔드가 콘텐츠를 바꾼 뒤 Authorization: Bearer <값> 으로 호출
REVALIDATE_SECRET=
